@page
@model Tracker.Server.RegisterPage
<!doctype html>
<html lang="zh"><meta charset="utf-8"><title>注册 · Codex Tracker</title>
<main><h1>注册账号</h1>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <p><label>邮箱 <input asp-for="Input.Email" type="email" autocomplete="email" required></label></p>
    <p><label>密码（至少 15 个字符） <input asp-for="Input.Password" type="password" autocomplete="new-password" minlength="15" required></label></p>
    <p><label>确认密码 <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required></label></p>
    <button>注册并验证邮箱</button>
</form><p><a href="/Identity/Account/Login">登录</a></p></main></html>

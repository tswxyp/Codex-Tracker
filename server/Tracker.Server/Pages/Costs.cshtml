@page "/costs"
@model Tracker.Server.CostPage
@using Tracker.Server
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var r=Model.Report;
    var selected=r?.BillingId;
    string Title(string k)=>k switch {"bill"=>"订阅账单","rule"=>"价格与权重","credits"=>"Credits 凭据",_=>"重置记录"};
    string Display(decimal? amount)=>amount?.ToString("0.############",System.Globalization.CultureInfo.InvariantCulture)??"待核算";
    string When(long ms)=>DateTimeOffset.FromUnixTimeMilliseconds(ms).UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss 'UTC'");
    var k=Model.Kind;
}
<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>成本核算 · Codex Tracker</title><style>
:root{color-scheme:light dark;--line:color-mix(in srgb,currentColor 22%,transparent);--accent:#007a70}
*{box-sizing:border-box}body{max-width:76rem;margin:auto;padding:1.5rem;font:16px/1.55 "Source Sans 3","Segoe UI",sans-serif}a{color:inherit;text-underline-offset:4px}
h1{font-size:2.25rem;margin:.7em 0 .35em} h2{font-size:1.2rem;margin:1.6em 0 .65em}nav,.actions{display:flex;gap:1.1rem;align-items:center;flex-wrap:wrap}
.cards,.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));gap:1rem}.cards{border-block:1px solid var(--line);padding:1.1rem 0}.cards strong{display:block;font-size:1.5rem}
.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}td,th{text-align:left;padding:.55rem;border-bottom:1px solid var(--line)}code{overflow-wrap:anywhere}
label{display:grid;gap:.3rem}input,select,textarea,button{font:inherit;padding:.45rem .65rem;max-width:100%}button{cursor:pointer}.save{background:#006b60;color:white;border:0;border-radius:4px;padding:.55rem 1.3rem}.active{font-weight:700;text-decoration-thickness:3px}.message{border-inline-start:4px solid #b68820;padding:.4rem 1rem}
details{margin:.7rem 0}summary{cursor:pointer}.ledger{margin:1rem 0 2rem}.ledger form{margin-top:.8rem}
</style></head><body><nav><a href="/dashboard">用量统计</a><a href="/finance">项目财务</a><a href="/devices">设备</a></nav><h1>成本核算</h1>
@if(Model.Error!=null){<p class="message" role="alert">@Model.Error</p>}
@if(Model.Books.Bills.Count>0){
<form method="get" class="actions"><label>查看账期<select name="billId">@foreach(var b in Model.Books.Bills.OrderByDescending(b=>b.Value.Start)){<option value="@b.Id" selected="@(selected==b.Id)">@b.Value.Plan · @b.Value.Start 至 @b.Value.End</option>}</select></label><button>切换</button></form>
}
@if(r!=null){
<h2>@r.Bill.Plan · @r.Bill.Start 至 @r.Bill.End</h2>
<div class="cards"><div>订阅实付<strong>@r.Bill.Currency @Display(r.Bill.Paid)</strong>人民币 @Display(r.Bill.PaidCny) 元</div>
<div>API 等效成本 · @r.ApiStatus<strong>@r.Bill.ApiCurrency @(r.ApiStatus=="UNKNOWN"?"待核算":Display(r.KnownApi))</strong>已知计价小计</div>
<div>本账期资源占比依据<strong>@(r.Reasons.Length>0?"待核算":r.Basis)</strong>统计截至 @When(r.Through)</div></div>
@if(r.Reasons.Length>0){<p class="message">@string.Join(" · ",r.Reasons.Select(CostPage.Reason))</p>}
<details><summary>按 Token 类别查看 API 等效成本</summary><table><thead><tr><th>计价类别</th><th>已知小计 (@r.Bill.ApiCurrency)</th><th>缺项事件数</th></tr></thead><tbody>
@foreach(var (code,label) in new[]{("INPUT","普通输入"),("CACHE_READ","缓存读"),("CACHE_WRITE","缓存写"),("OUTPUT","输出")}){
    var amounts=r.Evidence.Select(e=>e.Api.Components.GetValueOrDefault(code)).ToList();
    <tr><td>@label</td><td>@(amounts.Any(v=>v.HasValue)?Display(amounts.Sum()):"待核算")</td><td>@amounts.Count(v=>!v.HasValue)</td></tr>
}</tbody></table></details>
@if(r.Through<r.End && r.Reasons.Length==0){<p>账期内暂计。当前分摊使用截至上述时间的资源占比，后续用量和修订会触发重算。</p>}
<div class="scroll"><table><thead><tr><th>任务 / 线程</th><th>API 等效 (@r.Bill.ApiCurrency)</th><th>Credits · @r.Basis</th><th>本账期资源占比</th><th>订阅分摊 (@r.Bill.Currency)</th></tr></thead>
<tbody>@foreach(var line in r.Lines){<tr><td><code>@(line.Thread=="@pool"?"未归属池":line.Thread)</code></td><td>@(line.ApiStatus=="UNKNOWN"?"待核算":Display(line.ApiKnown)) · @line.ApiStatus</td><td>@Display(line.Credits)</td><td>@(line.Share.HasValue?Display(line.Share)+"%":"待核算")</td><td>@Display(line.Allocation)</td></tr>}</tbody></table></div>
@if(r.Lines.Any(x=>x.Allocation!=null)){
@if(r.Lines.Any(x=>x.TaskGroup!=null && x.Allocation!=null)){
<h2>任务组分摊</h2><ul>@foreach(var group in r.Lines.Where(l=>l.TaskGroup!=null && l.Allocation!=null).GroupBy(l=>l.TaskGroup)){
<li>@(group.First().GroupName??group.Key) · @r.Bill.Currency @Display(group.Sum(l=>l.Allocation))</li>}</ul>
}
<h2>项目分摊</h2><ul>@foreach(var group in r.Lines.Where(l=>l.Allocation!=null).GroupBy(l=>l.Project)){
<li>@(group.First().ProjectName??group.Key??"未归属项目池") · @r.Bill.Currency @Display(group.Sum(l=>l.Allocation))</li>}</ul>
}
@if(r.Resets.Count>0){<h2>账期内重置</h2><ul>@foreach(var item in r.Resets){<li>@When(item.Value.At) · @item.Value.Type · @item.Value.Currency @Display(item.Value.Cash) · @item.Value.Reference</li>}</ul>}
<div class="actions"><a asp-page-handler="Report" asp-route-billId="@selected">查看可复算明细 JSON</a>
<form method="post" asp-page-handler="Archive"><input type="hidden" name="billId" value="@selected"><button>保存本次核算快照</button></form></div>
@if(Model.Archives.Count>0){<details><summary>已存核算快照</summary><ul>@foreach(var digest in Model.Archives){<li><a asp-page-handler="Report" asp-route-billId="@selected" asp-route-digest="@digest"><code>@digest</code></a></li>}</ul></details>}
}
<section class="ledger"><h2>账本维护</h2><nav>@foreach(var tab in new[]{"bill","rule","credits","reset"}){<a href="?billId=@selected&kind=@tab" class="@(tab==k?"active":"")">@Title(tab)</a>}</nav>
@{
    IEnumerable<(Guid Id,string Label)> entries=k switch {
        "bill"=>Model.Books.Bills.Select(x=>(x.Id,x.Value.Plan+" · "+x.Value.Start)),
        "rule"=>Model.Books.Rules.Select(x=>(x.Id,x.Value.Type+" · "+x.Value.Model+" · "+x.Value.Unit+" · "+When(x.Value.From))),
        "credits"=>Model.Books.Credits.Where(x=>x.Value.BillId==selected).Select(x=>(x.Id,x.Value.Evidence+" · "+x.Value.Source)),
        _=>Model.Books.Resets.Where(x=>x.Value.BillId==selected).Select(x=>(x.Id,x.Value.Type+" · "+x.Value.Reference))};
}
@if(entries.Any()){<details><summary>选择已有记录进行修订</summary><ul>@foreach(var e in entries){<li><a href="?billId=@(k=="bill"?e.Id:selected)&kind=@k&edit=@e.Id">@e.Label</a></li>}</ul></details>}
@if(k=="rule"){<p><a href="?billId=@selected&kind=rule&preset=gpt-4.1-standard">载入 GPT-4.1 标准文本 API 公开参考价</a> · 2026-11-19 核对，保存前可调整适用期间。</p>}
@if((k=="credits" || k=="reset") && selected==null){<p>请先录入订阅账单。</p>}else{
<form method="post"><input type="hidden" name="kind" value="@k"><input type="hidden" name="id" value="@Model.EditId"><input type="hidden" name="version" value="@Model.Version"><input type="hidden" name="bill_id" value="@selected">
<h2>@((Model.Version==0?"新增":"修订")+Title(k))</h2><div class="fields">
@if(k=="bill"){
<label>订阅计划<input name="plan" type="text" required value="@(Model.Field("plan",""))"></label><label>首日（含）<input name="start" type="date" required value="@(Model.Field("start",""))"></label><label>结束日（不含）<input name="end" type="date" required value="@(Model.Field("end",""))"></label><label>账期时区<input name="zone" type="text" required value="@(Model.Field("zone","Asia/Shanghai"))"></label>
<label>实付币种<input name="currency" type="text" required value="@(Model.Field("currency","CNY"))"></label><label>实付原币金额<input name="paid" type="number" required min="0" step="any" value="@(Model.Field("paid",""))"></label><label>实际折合人民币<input name="paid_cny" type="number" required min="0" step="any" value="@(Model.Field("paid_cny",""))"></label><label>支付日期<input name="payment_date" type="date" required value="@(Model.Field("payment_date",""))"></label>
<label>API 报价币种<input name="api_currency" type="text" required value="@(Model.Field("api_currency","USD"))"></label><label>整期权重版本<input name="weight_set" type="text" required value="@(Model.Field("weight_set",CodexTracker.Billing.CodexCreditRates.Version))"></label><label>已核实所有来源覆盖至（UTC，可留空）<input name="covered_through" type="datetime-local" step="0.001" value="@(Model.TimeField("covered_through"))"></label>
}else if(k=="rule"){
<label>规则类型<select name="type">
<option value="PRICE" selected="@(Model.Field("type","PRICE")=="PRICE")">API 价格</option>
<option value="WEIGHT" selected="@(Model.Field("type","PRICE")=="WEIGHT")">估算 Credits 权重</option>
</select></label><label>币种或权重版本<input name="unit" type="text" required value="@(Model.Field("unit","USD"))"></label><label>模型标识<input name="model" type="text" required value="@(Model.Field("model",""))"></label>
<label>适用档位<select name="speed">
<option value="any" selected="@(Model.Field("speed","any")=="any")">各档位通用（须有依据）</option>
<option value="standard" selected="@(Model.Field("speed","any")=="standard")">标准</option>
<option value="fast" selected="@(Model.Field("speed","any")=="fast")">快速</option>
<option value="ultrafast" selected="@(Model.Field("speed","any")=="ultrafast")">极速</option>
<option value="priority" selected="@(Model.Field("speed","any")=="priority")">优先</option>
<option value="batch" selected="@(Model.Field("speed","any")=="batch")">批处理</option>
</select></label>
<label>生效时间（UTC）<input name="from" type="datetime-local" required step="0.001" value="@(Model.TimeField("from"))"></label><label>失效时间（UTC，可留空）<input name="until" type="datetime-local" step="0.001" value="@(Model.TimeField("until"))"></label>
<label>普通输入 / 百万 Token<input name="input" type="number" min="0" step="any" value="@(Model.Field("input",""))"></label><label>缓存读 / 百万 Token<input name="read" type="number" min="0" step="any" value="@(Model.Field("read",""))"></label><label>缓存写 / 百万 Token<input name="write" type="number" min="0" step="any" value="@(Model.Field("write",""))"></label><label>输出 / 百万 Token<input name="output" type="number" min="0" step="any" value="@(Model.Field("output",""))"></label>
<label>缓存写口径<select name="write_basis">
<option value="unknown" selected="@(Model.Field("write_basis","unknown")=="unknown")">尚无归类依据</option>
<option value="included" selected="@(Model.Field("write_basis","unknown")=="included")">已包含在输入</option>
<option value="separate" selected="@(Model.Field("write_basis","unknown")=="separate")">单独计量</option>
</select></label><label>价格来源 HTTPS 链接或权重依据<input name="source" type="text" required value="@(Model.Field("source",""))"></label>
}else if(k=="credits"){
<label>凭据范围<select name="evidence">
<option value="SETTLED" selected="@(Model.Field("evidence","SETTLED")=="SETTLED")">官方账期实际扣减</option>
<option value="BALANCE" selected="@(Model.Field("evidence","SETTLED")=="BALANCE")">账号余额观测</option>
<option value="LIFETIME_ESTIMATE" selected="@(Model.Field("evidence","SETTLED")=="LIFETIME_ESTIMATE")">官方界面生命周期估算</option>
</select></label>
<label>凭据引用（脱敏）<input name="source" type="text" required value="@(Model.Field("source",""))"></label><label>统计开始（UTC）<input name="start" type="datetime-local" required step="0.001" value="@(Model.TimeField("start"))"></label><label>统计截至（UTC，不含）<input name="through" type="datetime-local" required step="0.001" value="@(Model.TimeField("through"))"></label>
<label>凭据总 Credits<input name="total" type="number" required min="0" step="any" value="@(Model.Field("total",""))"></label><label>分项（每行 线程ID=数量；未归属用 @@pool）<textarea name="parts" rows="4">@Model.PartsField()</textarea></label>
}else{
<label>重置类型<select name="type">
<option value="UNKNOWN" selected="@(Model.Field("type","UNKNOWN")=="UNKNOWN")">未知</option>
<option value="GLOBAL" selected="@(Model.Field("type","UNKNOWN")=="GLOBAL")">Global Reset</option>
<option value="SCHEDULED" selected="@(Model.Field("type","UNKNOWN")=="SCHEDULED")">计划重置</option>
<option value="BANKED" selected="@(Model.Field("type","UNKNOWN")=="BANKED")">储备重置</option>
<option value="PAID" selected="@(Model.Field("type","UNKNOWN")=="PAID")">付费重置</option>
<option value="USAGE_CREDITS" selected="@(Model.Field("type","UNKNOWN")=="USAGE_CREDITS")">额外 Credits</option>
</select></label>
<label>发生时间（UTC）<input name="at" type="datetime-local" required step="0.001" value="@(Model.TimeField("at"))"></label><label>唯一凭据引用（脱敏）<input name="reference" type="text" required value="@(Model.Field("reference",""))"></label><label>之前额度<input name="before" type="number" min="0" step="any" value="@(Model.Field("before",""))"></label><label>之后额度<input name="after" type="number" min="0" step="any" value="@(Model.Field("after",""))"></label>
<label>现金币种<input name="currency" type="text" required value="@(Model.Field("currency","CNY"))"></label><label>实付（免费填 0，未知留空）<input name="cash" type="number" min="0" step="any" value="@(Model.Field("cash",""))"></label>
}
</div><p><button class="save">@("保存"+Title(k))</button></p></form>
}</section></body></html>

<Window x:Class="CodexTracker.Viewer.TaskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Tracker · 本地任务" Width="1150" Height="620" MinWidth="700" MinHeight="320" Background="#F5F6F8" FontFamily="Segoe UI, Microsoft YaHei UI" Loaded="Refresh">
  <DockPanel Margin="22">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Padding="14,5" Margin="0,0,8,0" Click="Choose">选择数据库</Button>
        <Button Padding="14,5" Click="Refresh">刷新</Button>
      </StackPanel>
      <TextBlock Text="本地任务" FontSize="24" FontWeight="SemiBold"/>
    </DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap"/>
    <DataGrid x:Name="Tasks" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="29">
      <DataGrid.Columns>
        <DataGridTextColumn Header="线程 ID" Binding="{Binding Thread}" Width="220"/>
        <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="115"/>
        <DataGridTextColumn Header="已核算 Token" Binding="{Binding Total,StringFormat=N0,TargetNullValue=未知}" Width="110"/>
        <DataGridTextColumn Header="其中待核实" Binding="{Binding PartialTokens,StringFormat=N0}"/>
        <DataGridTextColumn Header="缓存读" Binding="{Binding CacheRead,StringFormat=N0,TargetNullValue=未知}"/>
        <DataGridTextColumn Header="缓存写" Binding="{Binding CacheWrite,StringFormat=N0,TargetNullValue=未知}"/>
        <DataGridTextColumn Header="总历时" Binding="{Binding Wall}"/>
        <DataGridTextColumn Header="有证据活跃" Binding="{Binding Active}"/>
        <DataGridTextColumn Header="已知暂停" Binding="{Binding Paused}"/>
        <DataGridTextColumn Header="未知时间" Binding="{Binding Unknown}"/>
        <DataGridTextColumn Header="状态" Binding="{Binding State}"/>
        <DataGridTextColumn Header="质量提示数" Binding="{Binding Issues}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
